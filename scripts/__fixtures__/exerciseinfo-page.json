        {
          "id": 345,
          "uuid": "c788d643-150a-4ac7-97ef-84643c6419bf",
          "name": "2 Handed Kettlebell Swing",
          "exercise": 9,
          "description": "<ol>\n<li>Stand with your feet slightly wider than shoulder-width, the kettlebell on the floor about 20-30 cm in front of your toes.</li>\n<li>Hinge at the hips with a slight bend in the knees and a flat back, and grip the handle with both hands.</li>\n<li>Hike the kettlebell back between your legs, then drive your hips forward explosively so that it swings forward and up to chest or shoulder height (Russian style, not overhead). Your arms stay straight and relaxed, the power comes from the hips.</li>\n<li>Let the kettlebell swing back down, hinge again as it passes between your legs and go straight into the next rep.</li>\n</ol>\n",
          "created": "2023-08-06T10:17:17.349574+02:00",
          "language": 2,
          "license": 2,
          "license_author": "deusinvictus"
        }
